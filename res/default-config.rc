// The embedded default settings (res/cabbycodes.toml). D2RLoader writes them to
// <scope>/d2rloader/config/cabbycodes.toml the first time the plugin loads and
// never overwrites a user's copy.
// The runes-only build (D2RCC_RUNES_ONLY) embeds its own, res/rune-marker.toml.
#include <D2RLPlugin/resource.h>

#ifdef D2RCC_RUNES_ONLY
D2RL_PLUGIN_CONFIG_RESOURCE_ID RCDATA "rune-marker.toml"
#else
D2RL_PLUGIN_CONFIG_RESOURCE_ID RCDATA "cabbycodes.toml"
#endif
